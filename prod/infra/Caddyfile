# One site: /api/* goes to FastAPI, everything else is the web app's static files.
# See docs/development_setup.md §6.

:8080 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	# The files the browser shares with the server (prod/shared/): the
	# permission table and the version. Nothing else from that folder.
	@shared path /shared/permissions.json /shared/version.json
	handle @shared {
		root * /srv
		header Cache-Control no-cache
		file_server
	}

	handle {
		root * /srv/web
		# Ask every time whether a file changed (a quick 304 if not), so a
		# browser never runs yesterday's JavaScript.
		header Cache-Control no-cache
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
