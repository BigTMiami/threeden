# Short names for common commands. Run from prod/. See docs/development_setup.md §9.

SHELL := /bin/bash
COMPOSE := docker compose
RUN_API := $(COMPOSE) run --rm api

.PHONY: help up down build logs migrate revision test e2e psql seed reset-db check check-server check-web format ios ios-build ios-test

help: ## list the commands
	@grep -E '^[a-z-]+:.*## ' $(MAKEFILE_LIST) | awk -F':.*## ' '{printf "  make %-10s %s\n", $$1, $$2}'

up: ## start the stack in the background
	$(COMPOSE) up -d

down: ## stop it (data kept)
	$(COMPOSE) down

build: ## rebuild the API image (after changing dependencies)
	$(COMPOSE) build api

logs: ## follow the API's logs
	$(COMPOSE) logs -f api

migrate: ## alembic upgrade head
	$(RUN_API) alembic upgrade head

revision: ## new autogenerated migration: make revision m="add events"
	@test -n "$(m)" || (echo 'usage: make revision m="what changed"' && exit 1)
	$(RUN_API) alembic revision --autogenerate -m "$(m)"

test: ## pytest in the container, against a separate test database
	$(RUN_API) pytest

e2e: ## browser checks of the web app against the running stack (Chromium, in Docker)
	$(COMPOSE) run --rm e2e

psql: ## a database prompt
	$(COMPOSE) exec db psql -U threeden threeden

seed: ## load the demo groups (Cycle 4)
	@echo "Not yet: the seed script comes in Cycle 4."

reset-db: ## delete the database and start fresh
	$(COMPOSE) down -v
	$(COMPOSE) up -d
	$(RUN_API) alembic upgrade head

check: check-server check-web ## all checks: Ruff, then ESLint and TypeScript

check-server: ## Ruff lint and format check
	$(RUN_API) ruff check .
	$(RUN_API) ruff format --check .

check-web: ## ESLint and TypeScript for web/ (in a Node container)
	$(COMPOSE) run --rm webcheck

format: ## Ruff: fix what it can and format
	$(RUN_API) ruff check --fix .
	$(RUN_API) ruff format .

IOS_SIM ?= iPhone 17
IOS_DEST := platform=iOS Simulator,name=$(IOS_SIM)

ios: ## regenerate the Xcode project (after pulling, or adding Swift files)
	cd ios && xcodegen generate

ios-build: ios ## build the app for the Simulator
	xcodebuild -project ios/ThreeDen.xcodeproj -scheme ThreeDen -destination '$(IOS_DEST)' -quiet build

ios-test: ios ## iOS unit tests in the Simulator (IOS_SIM="iPhone 16" to pick another)
	@# Boot first and wait: a Simulator that's still starting refuses to launch the tests.
	xcrun simctl bootstatus '$(IOS_SIM)' -b > /dev/null
	set -o pipefail; xcodebuild -project ios/ThreeDen.xcodeproj -scheme ThreeDen \
		-destination '$(IOS_DEST)' test 2>&1 \
		| grep -E '✘|Test run with|TEST (SUCCEEDED|FAILED)|error:|Failure Reason'
