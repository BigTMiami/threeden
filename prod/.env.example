# Copy to .env (never committed) and change the values as needed.
POSTGRES_PASSWORD=dev-only-password
DATABASE_URL=postgresql+psycopg://threeden:dev-only-password@db:5432/threeden
# pytest uses its own database, created on first run (make test).
TEST_DATABASE_URL=postgresql+psycopg://threeden:dev-only-password@db:5432/threeden_test
APP_ENV=development
SESSION_SECRET=change-me
